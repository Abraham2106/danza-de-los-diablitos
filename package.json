{
  "name": "danza-de-los-diablitos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "dev:api": "wrangler dev --port 8787 --ip 127.0.0.1",
    "check:worker": "tsc -p worker/tsconfig.json --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/josefin-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261118.1",
    "@types/three": "0.170.0",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4",
    "wrangler": "4.164.0"
  },
  "engines": {
    "node": "22.x"
  }
}
